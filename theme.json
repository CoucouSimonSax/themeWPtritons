{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "660px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink-900",
					"name": "Encre",
					"color": "#000000"
				},
				{
					"slug": "ink-700",
					"name": "Texte",
					"color": "#2b2b2b"
				},
				{
					"slug": "ink-500",
					"name": "Gris moyen",
					"color": "#5e5e5e"
				},
				{
					"slug": "ink-300",
					"name": "Texte discret",
					"color": "#8f8f8f"
				},
				{
					"slug": "ink-200",
					"name": "Bordure de champ",
					"color": "#b3b3b3"
				},
				{
					"slug": "ink-100",
					"name": "Filet",
					"color": "#d6d6d6"
				},
				{
					"slug": "paper-200",
					"name": "Surlignage",
					"color": "#e4e4e4"
				},
				{
					"slug": "paper-100",
					"name": "Bloc creux",
					"color": "#f0f0f0"
